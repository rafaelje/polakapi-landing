---
import ThemeToggle from '../components/ThemeToggle';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#0d0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PolakAPI" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <div class="site-frame">
      <header class="site-nav">
        <a class="brand" href="#top" aria-label="PolakAPI home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>polakapi</strong>
        </a>
        <nav aria-label="Primary navigation">
          <a href="#workspace">Workspace</a>
          <a href="#features">Features</a>
          <a href="#workflow">Workflow</a>
        </nav>
        <div class="nav-actions">
          <a class="github-link" href="https://github.com/rafaelje/polakapi" target="_blank" rel="noreferrer" aria-label="PolakAPI on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.96a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.89v2.82c0 .27.18.59.69.49A10.27 10.27 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z" /></svg>
          </a>
          <ThemeToggle client:only="react" />
          <a class="nav-cta" href="https://github.com/rafaelje/polakapi/releases/latest" target="_blank" rel="noreferrer">Download</a>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a class="brand footer-brand" href="#top">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>polakapi</strong>
        </a>
        <p>Local terminals. Focused work.</p>
        <a href="https://github.com/rafaelje/polakapi" target="_blank" rel="noreferrer">GitHub ↗</a>
      </footer>
    </div>
  </body>
</html>
